#!/bin/sh
set -e

case "$1" in
    remove)
        # Without the binder its table would stay, frozen at the guests of
        # the moment (bind-callers-to-their-bridge-port D-h).
        if command -v nft >/dev/null 2>&1; then
            nft delete table bridge vtpm_mds_bind >/dev/null 2>&1 || true
        fi
        ;;
    purge)
        rm -rf /var/lib/vtpm-mds
        ;;
esac

#DEBHELPER#

exit 0
