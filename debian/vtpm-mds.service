[Unit]
Description=vTPM metadata and attestation service (IMDS)
Documentation=https://github.com/dembaca/vtpm-mds
Documentation=file:///usr/share/doc/vtpm-mds/README.Debian
After=network-online.target pve-cluster.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=12

[Service]
Type=simple
ExecStart=/usr/sbin/vtpm-mds -config /etc/vtpm-mds/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# Bind the IMDS bridge address (Ansible vmbr_imds / nftables DNAT).
# Root is required to read /etc/pve, /proc/net/arp, and DevID CA private keys.
AmbientCapabilities=CAP_NET_BIND_SERVICE
LimitNOFILE=65536

# State (JWKS, optional host signing key). Config lives in /etc/vtpm-mds.
ReadWritePaths=/var/lib/vtpm-mds
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

# Confinement (harden-the-service-unit). Root without capabilities reads only
# what root owns: /etc/pve, the CA key and the config all are.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectSystem=strict
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
UMask=0077
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# Guests and the host's own calls are link-local; nothing goes outbound.
IPAddressDeny=any
IPAddressAllow=169.254.0.0/16 localhost

[Install]
WantedBy=multi-user.target
