[Unit]
Description=vTPM metadata and attestation service (IMDS)
Documentation=https://github.com/dembaca/vtpm-mds
Documentation=file:///usr/share/doc/vtpm-mds/README.Debian
After=network-online.target pve-cluster.service
# Restarted with pmxcfs, so the read-only view of /etc/pve is rebuilt on remount.
PartOf=pve-cluster.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=12

[Service]
Type=simple
ExecStart=/usr/sbin/vtpm-mds -config /etc/vtpm-mds/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# Bind the IMDS bridge address (Ansible vmbr_imds / nftables DNAT).
AmbientCapabilities=CAP_NET_BIND_SERVICE
LimitNOFILE=65536

# Its own user (run-the-daemon-as-its-own-user). www-data reads /etc/pve as
# Proxmox ships it (root:www-data 0640), but not /etc/pve/priv.
User=vtpm-mds
Group=vtpm-mds
SupplementaryGroups=www-data
# Cluster DevID intermediate private key (not the offline root). Read by
# systemd as root and handed over as credential devid_ca.key; a missing file
# stops the start (243/CREDENTIALS). Another path: a drop-in that first resets
# the setting with an empty "LoadCredential=" line. Keep the credential name;
# only the file content is the per-cluster intermediate.
LoadCredential=devid_ca.key:/etc/ssl/private/proxmox_devid_ca.key

# State directory, owned by the user; config lives in /etc/vtpm-mds.
StateDirectory=vtpm-mds
StateDirectoryMode=0750
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

# Confinement (harden-the-service-unit).
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectSystem=strict
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
UMask=0077
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# A blocked call fails with EPERM instead of killing the daemon with SIGSYS.
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Guests and the host's own calls are link-local; nothing goes outbound.
IPAddressDeny=any
IPAddressAllow=169.254.0.0/16 localhost

[Install]
WantedBy=multi-user.target
