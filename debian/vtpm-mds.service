[Unit]
Description=vTPM metadata and attestation service (IMDS)
Documentation=https://github.com/dembaca/vtpm-mds
Documentation=file:///usr/share/doc/vtpm-mds/README.Debian
After=network-online.target pve-cluster.service
# Restarted with pmxcfs, so the read-only view of /etc/pve is rebuilt on remount.
PartOf=pve-cluster.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=12

[Service]
Type=simple
ExecStart=/usr/sbin/vtpm-mds -config /etc/vtpm-mds/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# Bind the IMDS bridge address (Ansible vmbr_imds / nftables DNAT).
# Runs as root for /etc/pve and the CA key; see the confinement below.
AmbientCapabilities=CAP_NET_BIND_SERVICE
LimitNOFILE=65536

# State directory; config lives in /etc/vtpm-mds.
ReadWritePaths=/var/lib/vtpm-mds
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

# Confinement (harden-the-service-unit). Root without capabilities reads only
# what root owns or its groups may read; ssl-cert covers a CA key that site
# PKI tooling leaves group-readable under /etc/ssl/private.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
SupplementaryGroups=ssl-cert
ProtectSystem=strict
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
UMask=0077
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# A blocked call fails with EPERM instead of killing the daemon with SIGSYS.
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Guests and the host's own calls are link-local; nothing goes outbound.
IPAddressDeny=any
IPAddressAllow=169.254.0.0/16 localhost

[Install]
WantedBy=multi-user.target
