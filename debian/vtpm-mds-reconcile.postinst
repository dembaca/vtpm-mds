#!/bin/sh
set -e

#DEBHELPER#

# debian/rules passes --no-start to dh_installsystemd, which also drops
# debhelper's daemon-reload; reload so the installed unit is the effective one.
# A first install starts nothing: the unit waits for
# /etc/vtpm-mds-reconcile/config.yaml and the operator's drop-in.
if [ "$1" = "configure" ] && [ -z "$DPKG_ROOT" ] && [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null 2>&1 || true
fi

# An upgrade restarts a running reconciler and leaves a stopped one stopped
# (package-the-reconciler D-f, as restart-the-service-on-upgrade for the host
# package). A refused restart is reported but does not fail the upgrade.
if [ "$1" = "configure" ] && [ -n "$2" ] && [ -z "$DPKG_ROOT" ] && [ -d /run/systemd/system ]; then
    if ! deb-systemd-invoke try-restart vtpm-mds-reconcile.service >/dev/null; then
        echo "vtpm-mds-reconcile: restart after upgrade refused; see journalctl -u vtpm-mds-reconcile" >&2
    fi
fi

exit 0
