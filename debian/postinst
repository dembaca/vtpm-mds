#!/bin/sh
set -e

case "$1" in
    configure)
        mkdir -p /var/lib/vtpm-mds
        chmod 0750 /var/lib/vtpm-mds
        ;;
esac

#DEBHELPER#

# debian/rules passes --no-start to dh_installsystemd deliberately: binding
# 169.254.169.1:80 fails on build and lab hosts that have no IMDS bridge, so
# the package enables the unit without starting it. That flag also suppresses
# debhelper's own `systemctl daemon-reload`, which it emits as part of the
# start/restart snippet — without the reload below, systemd keeps serving the
# unit definition it loaded before this upgrade, and says so:
#
#   Warning: The unit file ... changed on disk. Run 'systemctl daemon-reload'.
#
# Reload the manager so the installed unit is the effective one. Still no
# start on a first install: whether the service runs stays an operator
# decision; an upgrade only restarts a daemon that already runs (below).
if [ "$1" = "configure" ] && [ -z "$DPKG_ROOT" ] && [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null 2>&1 || true
fi

# An upgrade restarts each unit of the package (vtpm-mds, vtpm-mds-bind) if,
# and only if, it is running, so the node ends up serving the version just
# installed; a stopped unit stays stopped and a first install ($2 empty)
# starts nothing. This follows the reload so
# the restart uses the installed unit. deb-systemd-invoke honours
# policy-rc.d and passes try-restart to systemctl. A restart systemd refuses
# is reported but does not fail the upgrade; with Type=simple a daemon that
# exits after it was forked is not seen here, only in the journal, where
# Restart=on-failure retries it (restart-the-service-on-upgrade D-d).
if [ "$1" = "configure" ] && [ -n "$2" ] && [ -z "$DPKG_ROOT" ] && [ -d /run/systemd/system ]; then
    for unit in vtpm-mds vtpm-mds-bind; do
        if ! deb-systemd-invoke try-restart "$unit.service" >/dev/null; then
            echo "vtpm-mds: restart of $unit after upgrade refused; see journalctl -u $unit" >&2
        fi
    done
fi

exit 0
