#!/usr/bin/make -f

export DH_VERBOSE = 1
export GO111MODULE = on
export GOTOOLCHAIN = auto
export GOPROXY ?= https://proxy.golang.org,direct
export CGO_ENABLED = 0

# Rules-Requires-Root: no redirects HOME into debian/.debhelper. Go then
# writes a mode-0555 module cache that dh_clean cannot delete. Keep caches
# in the source tree but outside debian/.
GO_WORKDIR := $(CURDIR)/.go-workdir
export HOME := $(GO_WORKDIR)
export GOPATH := $(GO_WORKDIR)
export GOCACHE := $(GO_WORKDIR)/cache
export GOMODCACHE := $(GO_WORKDIR)/mod

VERSION := $(shell dpkg-parsechangelog -S Version)

%:
	dh $@ --with installsysusers

override_dh_auto_clean:
	rm -rf bin
	# Skip dh_auto_clean (`make clean` → `go clean`); it would download
	# modules into HOME before dh_clean runs.

override_dh_auto_configure:

override_dh_auto_build:
	mkdir -p bin "$(GOCACHE)" "$(GOMODCACHE)"
	go build -buildvcs=false -trimpath -ldflags "-s -w -X main.Version=$(VERSION)" -o bin/vtpm-mds .
	go build -buildvcs=false -trimpath -ldflags "-s -w -X main.Version=$(VERSION)" -o bin/devid-enroll ./cmd/devid-enroll
	go build -buildvcs=false -trimpath -ldflags "-s -w -X main.Version=$(VERSION)" -o bin/vtpm-mds-bind ./cmd/vtpm-mds-bind

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	go test ./...
endif

override_dh_auto_install:
	install -d debian/vtpm-mds/usr/sbin
	install -m 0755 bin/vtpm-mds debian/vtpm-mds/usr/sbin/vtpm-mds
	install -m 0755 bin/vtpm-mds-bind debian/vtpm-mds/usr/sbin/vtpm-mds-bind
	install -d debian/vtpm-mds/usr/lib/systemd/system
	install -m 0644 debian/vtpm-mds-bind.service debian/vtpm-mds/usr/lib/systemd/system/vtpm-mds-bind.service
	install -d debian/devid-enroll/usr/bin
	install -m 0755 bin/devid-enroll debian/devid-enroll/usr/bin/devid-enroll

override_dh_dwz:
	# Go binaries are not compatible with dh_dwz.

override_dh_installsystemd:
	# Enable for next boot (the IMDS bridge is already provisioned by
	# Ansible) but do not start during dpkg -i — bind 169.254.169.1:80
	# fails on build/lab hosts that lack vmbr_imds.
	# NOTE: --no-start also drops debhelper's `systemctl daemon-reload`,
	# which it emits only as part of the start/restart snippet. debian/postinst
	# reloads the manager by hand to compensate; see the comment there.
	# --no-stop-on-upgrade drops the preinst that would otherwise stop the
	# daemon on every upgrade with nothing to start it again; postinst
	# restarts a running daemon instead (restart-the-service-on-upgrade).
	# Both units of the package, vtpm-mds and vtpm-mds-bind, are handled
	# alike: vtpm-mds-bind.service is installed in override_dh_auto_install
	# and picked up from the package tree.
	dh_installsystemd --no-start --no-stop-on-upgrade
