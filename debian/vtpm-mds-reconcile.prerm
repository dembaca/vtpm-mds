#!/bin/sh
set -e

# --no-start makes dh_installsystemd leave the stop on removal out, as for the
# host package (debian/prerm); stop the reconciler here.
if [ -d /run/systemd/system ]; then
    case "$1" in
        remove|deconfigure)
            deb-systemd-invoke stop vtpm-mds-reconcile.service >/dev/null || true
            ;;
    esac
fi

#DEBHELPER#

exit 0
